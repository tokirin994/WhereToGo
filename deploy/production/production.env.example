# Generated to .local/production/.env by prepare.py. This file contains no service passwords.
PORTAL_ORIGIN=https://my-portal.pages.dev
LEDGER_ORIGIN=https://my-ledger.pages.dev
IDENTITY_HOST=identity.example.com
TRAVEL_API_HOST=travel-api.example.com
LEDGER_API_HOST=ledger-api.example.com
IDENTITY_REALM=personal
IDENTITY_ADMIN_USERNAME=bootstrap-admin
ACME_EMAIL=operator@example.com
# Space-separated IPv4/IPv6 CIDRs, quoted for both Compose and the shell. Never 0.0.0.0/0.
ADMIN_ALLOWED_CIDRS='203.0.113.10/32'
# Initial placeholder intentionally authorizes nobody. Replace with the actual Keycloak user ID.
API_ALLOWED_SUBJECTS=00000000-0000-0000-0000-000000000000
TRAVEL_AI_BASE_URL=
TRAVEL_AI_MODEL=
TRAVEL_AI_PROTOCOL=chat-completions
TRAVEL_AI_TOKEN_FIELD=max_tokens
TRAVEL_AI_AUTH_MODE=api-key
TRAVEL_AI_ANTHROPIC_VERSION=2023-06-01
# Configure with rclone config; a destination is mandatory unless --local-only is explicitly passed.
BACKUP_RCLONE_DEST=
BACKUP_KEEP_DAYS=14
