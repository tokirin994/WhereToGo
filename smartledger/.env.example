SMARTLEDGER_DB_PASSWORD=replace-with-a-long-random-value
SMARTLEDGER_OIDC_ISSUER=https://identity.example.com/realms/personal
SMARTLEDGER_OIDC_AUDIENCE=smartledger-api
SMARTLEDGER_ALLOWED_ORIGINS=https://portal.example.com,https://ledger.example.com
SMARTLEDGER_PUBLIC_URL=https://ledger.example.com
SMARTLEDGER_API_PORT=8090
API_OIDC_JWK_SET_URI=https://identity.example.com/realms/personal/protocol/openid-connect/certs
API_ALLOWED_SUBJECTS=replace-with-your-oidc-subject
API_ALLOW_ANY_AUTHENTICATED_USER=false
API_REQUESTS_PER_MINUTE=120
API_WRITES_PER_MINUTE=30
API_WEBDAV_REQUESTS_PER_MINUTE=10
DB_POOL_SIZE=4
FLYWAY_HISTORY_TABLE=smartledger_schema_history
# Server-only JSON: {"activeKeyId":"v1","keys":{"v1":"<base64 of 32 random bytes>"}}
# Supply through platform secrets; never use a VITE_ variable or commit a real value.
SMARTLEDGER_CREDENTIAL_KEYRING=
