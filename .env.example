# Development database password. Copy this file to .env and replace before use.
DB_PASSWORD=change-this-local-password

# Production API identity; leave development mock identity out of public deployments.
APP_OIDC_ISSUER=https://identity.example.com/realms/personal
APP_OIDC_AUDIENCE=wheretogo-api
API_OIDC_JWK_SET_URI=https://identity.example.com/realms/personal/protocol/openid-connect/certs
APP_CORS_ALLOWED_ORIGINS=https://portal.example.com
# OIDC sub values of the people allowed to use this private deployment.
API_ALLOWED_SUBJECTS=replace-with-your-oidc-subject
API_ALLOW_ANY_AUTHENTICATED_USER=false
API_REQUESTS_PER_MINUTE=120
API_WRITES_PER_MINUTE=30
DB_POOL_SIZE=4
# Set distinct table names when both APIs share one new managed database.
FLYWAY_HISTORY_TABLE=wheretogo_schema_history

# Optional client-side AMap JavaScript key. Keep service secrets out of source control.
VITE_AMAP_KEY=

# Optional server-side travel integrations. Never put these credentials in VITE_ variables.
TRAVEL_AI_BASE_URL=
TRAVEL_AI_API_KEY=
TRAVEL_AI_MODEL=
TRAVEL_AI_PROTOCOL=chat-completions
TRAVEL_AI_TOKEN_FIELD=max_tokens
TRAVEL_AI_AUTH_MODE=api-key
TRAVEL_AI_ANTHROPIC_VERSION=2023-06-01
TRAVEL_AI_MAX_TOKENS=6000
# Public personal-use services. Empty URL explicitly disables the corresponding service.
TRAVEL_GEOCODER_PROVIDER=photon
TRAVEL_GEOCODER_URL=https://photon.komoot.io/api/
TRAVEL_WEATHER_URL=https://api.open-meteo.com/v1/forecast
TRAVEL_DESTINATION_SEARCH_URL=https://geocoding-api.open-meteo.com/v1/search
TRAVEL_ROUTING_DRIVING_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
TRAVEL_ROUTING_WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving
