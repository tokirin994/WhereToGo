# Public build settings only. Never put passwords/provider keys in VITE_ variables.
VITE_LOCAL_MOCK_AUTH=false
VITE_AUTH_MODE=portal
VITE_APP_BASE_PATH=/
VITE_OIDC_AUTHORITY=https://identity.example.com/realms/personal
VITE_OIDC_CLIENT_ID=travel-web
VITE_OIDC_AUDIENCE=wheretogo-api
VITE_PORTAL_PUBLIC_URL=https://portal.example.com/
VITE_WHERE_TO_GO_PUBLIC_URL=https://travel.example.com/
VITE_SMARTLEDGER_PUBLIC_URL=https://ledger.example.com/
VITE_API_BASE_URL=https://travel-api.example.com
VITE_SMARTLEDGER_API_URL=https://ledger-api.example.com
# Split deployment without the portal: set VITE_AUTH_MODE=standalone, retain the same realm.
# Local dev port: 5175; unified deployment base: /travel/
